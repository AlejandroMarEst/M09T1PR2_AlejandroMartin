@page
@model M09T1PR2Razor_AlejandroMartin.Pages.GameInfoModel
@{
	ViewData["Title"] = "Game info";
}
<div class="text-center">
	<h1 class="display-4">@Model.Game.Title</h1>
</div>
<img src="@Model.Game.Img" alt="Game Image" class="game-img-info" />
<div class="text-center">
	<p>Developed by: @Model.Game.Dev</p>
	<p>Vots: @Model.Votes</p>
	<p>Description: @Model.Game.Description</p>
	@if (Model.LoggedIn)
	{
		@if (Model.Voted)
		{
			<form method="post" asp-handler="UnVote">
				<button type="submit" class="btn btn-primary" asp-page-handler="unvote" asp-route-gameId="@Model.Game.Id">Desvotar</button>
			</form>
		}
		else
		{
			<form method="post" asp-handler="Vote">
				<button type="submit" class="btn btn-primary" asp-page-handler="vote" asp-route-gameId="@Model.Game.Id">Votar</button>
			</form>
		}
	}
</div>
 